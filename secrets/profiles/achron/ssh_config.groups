# SSH config groups enabled for this profile.
#
# Each non-empty, non-comment line names a group directory under
# secrets/base/ssh_config.d/. Its fragments are decrypted and deployed to
# ~/.ssh/config.d/ as <group>_<fragment>.conf on `chezmoi apply`.
#
# This manifest is intentionally plaintext (group names only, no host data).
# The "common" group holds shared entries (e.g. github, gitea) and should
# normally be listed for every profile.
common
homelab
tokyo
vps
work_wst
