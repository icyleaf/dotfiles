#!/usr/bin/env bash
#
# Set up Ghostty Warp vendor symlink.
# Keeps vendor/ghostty-warp as a git submodule and links the required
# files and folders into ~/.config/ghostty so Ghostty reads from the
# user config directory without copying the source tree.
#
# To upgrade ghostty-warp:
#   git submodule update --remote vendor/ghostty-warp
#   git add vendor/ghostty-warp && git commit -m "chore: bump ghostty-warp to <version>"

set -eu

VENDOR_DIR="${HOME}/.local/share/ghostty-warp"
GHOSTTY_DIR="${HOME}/.config/ghostty"

link_path() {
  src="$1"
  dest="$2"

  mkdir -p "$(dirname "${dest}")"

  if [ -L "${dest}" ]; then
    current_target="$(readlink "${dest}")"
    if [ "${current_target}" = "${src}" ]; then
      echo "Link already in place: ${dest} -> ${src}"
      return 0
    fi
    rm "${dest}"
  elif [ -e "${dest}" ]; then
    backup="${dest}.bak"
    echo "Backing up existing path: ${dest} -> ${backup}"
    mv "${dest}" "${backup}"
  fi

  ln -s "${src}" "${dest}"
  echo "Linked: ${dest} -> ${src}"
}

ensure_dir() {
  mkdir -p "$1"
}

# Link the Ghostty Warp directories that are read-only from Ghostty's point of
# view.
link_path "${VENDOR_DIR}/themes" "${GHOSTTY_DIR}/themes"
link_path "${VENDOR_DIR}/presets" "${GHOSTTY_DIR}/presets"
link_path "${VENDOR_DIR}/fonts" "${GHOSTTY_DIR}/fonts"
link_path "${VENDOR_DIR}/tmux" "${GHOSTTY_DIR}/tmux"

# Keep platform and keybind directories local so current.conf symlinks can
# live there without modifying the vendor worktree.
ensure_dir "${GHOSTTY_DIR}/keybinds"
ensure_dir "${GHOSTTY_DIR}/platform"
link_path "${VENDOR_DIR}/keybinds/macos.conf" "${GHOSTTY_DIR}/keybinds/macos.conf"
link_path "${VENDOR_DIR}/platform/linux.conf" "${GHOSTTY_DIR}/platform/linux.conf"
link_path "${VENDOR_DIR}/platform/macos.conf" "${GHOSTTY_DIR}/platform/macos.conf"

# Ghostty only reads current.conf entrypoints (see ghostty config includes).
platform="linux"
case "$(uname -s)" in
  Darwin) platform="macos" ;;
  Linux) platform="linux" ;;
esac
link_path "${GHOSTTY_DIR}/platform/${platform}.conf" "${GHOSTTY_DIR}/platform/current.conf"
link_path "${GHOSTTY_DIR}/keybinds/${platform}.conf" "${GHOSTTY_DIR}/keybinds/current.conf"

# gconfig CLI lives in the vendor tree and is linked into PATH.
link_path "${VENDOR_DIR}/gconfig" "${GHOSTTY_DIR}/gconfig"
mkdir -p "${HOME}/.local/bin"
link_path "${GHOSTTY_DIR}/gconfig" "${HOME}/.local/bin/gconfig"
