#!/usr/bin/env bash
# run_onchange_deploy-secrets.sh.tmpl
#
# Deploys encrypted secrets (SSH private keys, SSH config fragments and shell
# env vars) from the chezmoi source directory to the home directory. Triggered
# automatically by chezmoi apply whenever the content of this rendered script
# changes (i.e., when any .age file in the active profile is modified or the
# profile's ssh_config.groups manifest changes).
#
# Change-detection manifest (chezmoi re-runs when any entry changes):
{{- range (glob (joinPath $.chezmoi.sourceDir "secrets" "base" "*.age")) }}
#   base/{{ base . }} size={{ (stat .).size }}
{{- end }}
{{- range (glob (joinPath $.chezmoi.sourceDir "secrets" "profiles" $.machine_profile "*.age")) }}
#   profiles/{{ $.machine_profile }}/{{ base . }} size={{ (stat .).size }}
{{- end }}
{{- range (glob (joinPath $.chezmoi.sourceDir "secrets" "profiles" $.machine_profile "ssh" "*.age")) }}
#   profiles/{{ $.machine_profile }}/ssh/{{ base . }} size={{ (stat .).size }}
{{- end }}
{{- range (glob (joinPath $.chezmoi.sourceDir "secrets" "base" "ssh_config.d" "*" "*.age")) }}
#   base/ssh_config.d/{{ dir . | base }}/{{ base . }} size={{ (stat .).size }}
{{- end }}
{{- range (glob (joinPath $.chezmoi.sourceDir "secrets" "profiles" $.machine_profile "ssh_config.d" "*.age")) }}
#   profiles/{{ $.machine_profile }}/ssh_config.d/{{ base . }} size={{ (stat .).size }}
{{- end }}
{{- $groupsRel := joinPath "secrets" "profiles" $.machine_profile "ssh_config.groups" }}
{{- if (glob (joinPath $.chezmoi.sourceDir $groupsRel)) }}
#   profiles/{{ $.machine_profile }}/ssh_config.groups:
{{- range (splitList "\n" (include $groupsRel)) }}
#   group| {{ . }}
{{- end }}
{{- end }}

set -euo pipefail

PROFILE={{ .machine_profile | quote }}
SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
AGE_KEY={{ .age_identity | quote }}
BASE_DIR="${SOURCE_DIR}/secrets/base"
PROFILE_DIR="${SOURCE_DIR}/secrets/profiles/${PROFILE}"
CONFIG_BASE_DIR="${SOURCE_DIR}/secrets/base/ssh_config.d"
CONFIG_PROFILE_DIR="${PROFILE_DIR}/ssh_config.d"
CONFIG_DEST_DIR="${HOME}/.ssh/config.d"
GROUPS_FILE="${PROFILE_DIR}/ssh_config.groups"

# ---------------------------------------------------------------------------
# Prerequisites — skip (non-fatal) when age cannot decrypt yet
# ---------------------------------------------------------------------------

if ! command -v age >/dev/null 2>&1; then
  echo "Warning: age CLI not found; skipping secret deployment." >&2
  exit 0
fi

if [ ! -f "${AGE_KEY}" ]; then
  echo "Warning: age identity not found at ${AGE_KEY}; skipping secret deployment." >&2
  echo "Restore the shared key from backup (see README) or generate one, then re-run apply." >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

deploy_age_file() {
  local src="$1"
  local dest="$2"
  local tmp

  tmp=$(mktemp)
  if age --decrypt -i "${AGE_KEY}" "${src}" >"${tmp}" 2>/dev/null; then
    mv "${tmp}" "${dest}"
    chmod 600 "${dest}"
  else
    rm -f "${tmp}"
    echo "Warning: skipping $(basename "${src}") (unable to decrypt age file)." >&2
  fi
}

ensure_ssh_dir() {
  mkdir -p "${HOME}/.ssh"
  chmod 700 "${HOME}/.ssh"
}

# Deploy all *.age files from a directory to a target directory.
# Usage: deploy_ssh_keys_from_dir <src_dir> <dest_dir>
deploy_ssh_keys_from_dir() {
  local src_dir="$1"
  local dest_dir="$2"

  shopt -s nullglob
  local key_files=("${src_dir}"/*.age)
  shopt -u nullglob

  if [ "${#key_files[@]}" -gt 0 ]; then
    ensure_ssh_dir
    for key_file in "${key_files[@]}"; do
      local key_name
      key_name=$(basename "${key_file}" .age)
      deploy_age_file "${key_file}" "${dest_dir}/${key_name}"
    done
  fi
}

# ---------------------------------------------------------------------------
# Base Secrets — SSH keys common to all devices
# ---------------------------------------------------------------------------

if [ -d "${BASE_DIR}" ]; then
  deploy_ssh_keys_from_dir "${BASE_DIR}" "${HOME}/.ssh"
fi

# ---------------------------------------------------------------------------
# Profile Secrets — env vars and device-specific SSH keys
# ---------------------------------------------------------------------------

mkdir -p "${HOME}/.config/zsh"

if [ -d "${PROFILE_DIR}" ] && [ "${PROFILE}" != "custom" ]; then
  # Deploy environment variables secret
  local_zsh_age="${PROFILE_DIR}/local.zsh.age"
  if [ -f "${local_zsh_age}" ]; then
    deploy_age_file "${local_zsh_age}" "${HOME}/.config/zsh/local.zsh"
  fi

  # Deploy profile-specific SSH keys
  profile_ssh_dir="${PROFILE_DIR}/ssh"
  if [ -d "${profile_ssh_dir}" ]; then
    deploy_ssh_keys_from_dir "${profile_ssh_dir}" "${HOME}/.ssh"
  fi
else
  # Custom Profile: no matching profile directory exists.
  # Deploy the scaffold so the shell can source local.zsh without errors.
  local_zsh_scaffold_src="${SOURCE_DIR}/secrets/profiles/custom/local.zsh.example"
  local_zsh_dest="${HOME}/.config/zsh/local.zsh"
  if [ ! -f "${local_zsh_dest}" ]; then
    if [ -f "${local_zsh_scaffold_src}" ]; then
      cp "${local_zsh_scaffold_src}" "${local_zsh_dest}"
    else
      touch "${local_zsh_dest}"
    fi
  fi
  chmod 600 "${local_zsh_dest}"
fi

# ---------------------------------------------------------------------------
# SSH Config Fragments
#
# Groups are shared fragments under secrets/base/ssh_config.d/<group>/. The
# active profile's whitelist (secrets/profiles/<profile>/ssh_config.groups)
# selects which groups are deployed; "common" is used when no manifest exists.
# Profile-only fragments live under secrets/profiles/<profile>/ssh_config.d/.
#
# Output files are named <group>_<fragment>.conf (or <profile>_<fragment>.conf)
# in ~/.ssh/config.d/, which the managed ~/.ssh/config includes via
# `Include config.d/*.conf`. The directory is fully generated: every *.conf
# file is regenerated on each apply, and stale ones are removed.
# ---------------------------------------------------------------------------

read_groups() {
  local groups=()
  local line

  if [ -f "${GROUPS_FILE}" ]; then
    while IFS= read -r line || [ -n "${line}" ]; do
      line="${line%%#*}"
      line="${line//[[:space:]]/}"
      [ -n "${line}" ] && groups+=("${line}")
    done < "${GROUPS_FILE}"
  else
    groups=("common")
  fi

  if [ "${#groups[@]}" -gt 0 ]; then
    printf '%s\n' "${groups[@]}"
  fi
}

deploy_config_group() {
  local group="$1"
  local group_dir="${CONFIG_BASE_DIR}/${group}"
  local fragment name

  if [ ! -d "${group_dir}" ]; then
    echo "Warning: unknown SSH config group '${group}'; skipping." >&2
    return 0
  fi

  shopt -s nullglob
  for fragment in "${group_dir}"/*.age; do
    name=$(basename "${fragment}" .age)
    deploy_age_file "${fragment}" "${CONFIG_DEST_DIR}/${group}_${name}"
  done
  shopt -u nullglob
}

if [ -d "${CONFIG_BASE_DIR}" ] || [ -d "${CONFIG_PROFILE_DIR}" ]; then
  ensure_ssh_dir
  mkdir -p "${CONFIG_DEST_DIR}"
  chmod 700 "${CONFIG_DEST_DIR}"

  # Regenerate from scratch so removed groups/fragments do not linger.
  find "${CONFIG_DEST_DIR}" -maxdepth 1 -type f -name '*.conf' -delete

  if [ -d "${CONFIG_BASE_DIR}" ]; then
    while IFS= read -r group; do
      [ -n "${group}" ] && deploy_config_group "${group}"
    done < <(read_groups)
  fi

  if [ -d "${CONFIG_PROFILE_DIR}" ]; then
    shopt -s nullglob
    for fragment in "${CONFIG_PROFILE_DIR}"/*.age; do
      name=$(basename "${fragment}" .age)
      deploy_age_file "${fragment}" "${CONFIG_DEST_DIR}/${PROFILE}_${name}"
    done
    shopt -u nullglob
  fi
fi
