#!/usr/bin/env bash
# omarchy-workspace-bindings
#
# Author and manage monitor-aware Workspace Bindings for the icyleaf.workspaces
# plugin. Bindings live in a Chezmoi-managed, per-profile source file:
#
#   <chezmoi source>/.chezmoitemplates/workspace-bindings.<machine_profile>.json
#
# `chezmoi apply` renders that source to the runtime file the plugin reads and
# hot-reloads:
#
#   ~/.config/hypr/workspace-bindings.json
#
# The menu flows use `omarchy menu` for selection; the `set`/`remove`/`list`/
# `status` commands are non-interactive and scriptable.

set -euo pipefail

RUNTIME_TARGET="${HOME}/.config/hypr/workspace-bindings.json"

notify() {
  command -v omarchy >/dev/null 2>&1 || return 0
  omarchy notification send "$1" "${2:-}" -g "󰍹" >/dev/null 2>&1 || true
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

require_cmds() {
  for cmd in chezmoi jq; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
  done
}

# Read the resolved profile from the persisted config rather than `chezmoi data`:
# the latter re-reads the whole source tree and trips over dangling, OS-specific
# symlinks that `chezmoi apply` deliberately tolerates.
machine_profile() {
  chezmoi dump-config | jq -r '.data.machine_profile // "custom"'
}

source_dir() {
  chezmoi source-path
}

state_file() {
  printf '%s/.chezmoitemplates/workspace-bindings.%s.json' "$(source_dir)" "$(machine_profile)"
}

ensure_state() {
  local file
  file="$(state_file)"
  mkdir -p "$(dirname "$file")"
  if [[ ! -f $file ]]; then
    printf '{\n  "version": 1,\n  "bindings": []\n}\n' >"$file"
  elif ! jq -e '.version == 1 and (.bindings | type == "array")' "$file" >/dev/null 2>&1; then
    die "invalid binding source: $file"
  fi
}

# Parse a `monitor` argument into a matcher JSON object:
#   id:0        -> { "id": 0 }
#   name:DP-1   -> { "name": "DP-1" }
#   desc:TEXT   -> { "desc": "TEXT" }
matcher_json() {
  local spec="$1" kind value
  kind="${spec%%:*}"
  value="${spec#*:}"
  case "$kind" in
    id)
      [[ $value =~ ^[0-9]+$ ]] || die "monitor id must be an integer: $value"
      jq -cn --argjson id "$value" '{id: $id}'
      ;;
    name)
      [[ -n $value ]] || die "monitor name must not be empty"
      jq -cn --arg name "$value" '{name: $name}'
      ;;
    desc)
      [[ -n $value ]] || die "monitor desc must not be empty"
      jq -cn --arg desc "$value" '{desc: $desc}'
      ;;
    *)
      die "monitor must be id:<n>, name:<connector> or desc:<text> (got '$spec')"
      ;;
  esac
}

# Upsert a binding, preserving the position of an existing class so same-class
# scene variants keep their authored order.
save_binding() {
  local class="$1" monitor="$2" slot="$3" focus="$4" file matcher tmp
  [[ -n $class ]] || die "class must not be empty"
  [[ $slot =~ ^([1-9]|10)$ ]] || die "slot must be 1..10 (got '$slot')"
  [[ $focus == "true" || $focus == "false" ]] || die "focus must be true or false"

  ensure_state
  file="$(state_file)"
  matcher="$(matcher_json "$monitor")"
  tmp="$(mktemp "${file}.XXXXXX")"

  # Match on class + monitor so a class may carry one binding per layout
  # (scene variant); the same class+monitor is updated in place.
  jq \
    --arg class "$class" \
    --argjson monitor "$matcher" \
    --argjson slot "$slot" \
    --argjson focus "$focus" \
    '
      .version = 1
      | (.bindings // []) as $bindings
      | { class: $class, target: { monitor: $monitor, slot: $slot }, focus: $focus } as $entry
      | ($bindings | map(.class == $class and .target.monitor == $monitor) | index(true)) as $at
      | .bindings = (if $at == null then $bindings + [$entry] else $bindings | .[$at] = $entry end)
    ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

# Remove all bindings for a class, or only the one targeting <monitor> when
# given (so scene variants can be removed individually).
remove_binding() {
  local class="$1" monitor="${2:-}" file tmp
  ensure_state
  file="$(state_file)"
  tmp="$(mktemp "${file}.XXXXXX")"
  if [[ -n $monitor ]]; then
    jq --arg class "$class" --argjson monitor "$(matcher_json "$monitor")" \
      '.bindings |= map(select(.class != $class or .target.monitor != $monitor))' "$file" >"$tmp"
  else
    jq --arg class "$class" '.bindings |= map(select(.class != $class))' "$file" >"$tmp"
  fi
  mv "$tmp" "$file"
}

apply_bindings() {
  chezmoi apply "$RUNTIME_TARGET" >/dev/null 2>&1 \
    || notify "Workspace Bindings" "Saved, but chezmoi apply failed."
}

# ---------------------------------------------------------------------------
# Selection helpers
# ---------------------------------------------------------------------------

# Where the helper drops the prefill the plugin's binding editor reads.
FORM_FILE="${HOME}/.cache/icyleaf/workspace-binding-form.json"

# Hand a prefill JSON to the plugin's `editBinding` IPC, which opens the form on
# the focused monitor. The form calls back with `save-binding` on save.
open_form() {
  local json="$1"
  mkdir -p "$(dirname "$FORM_FILE")"
  printf '%s\n' "$json" >"$FORM_FILE"
  command -v omarchy-shell >/dev/null 2>&1 || die "omarchy-shell not found"
  omarchy-shell -q icyleaf.workspaces editBinding >/dev/null 2>&1 \
    || notify "Workspace Bindings" "Could not open the binding editor."
}

running_app_options() {
  local clients
  clients=$(hyprctl -j clients 2>/dev/null) || return 1
  jq -r '
    map({ klass: (if (.initialClass // "") != "" then .initialClass else (.class // "") end), title: (.title // "") })
    | map(select(.klass != ""))
    | unique_by(.klass)
    | sort_by(.klass | ascii_downcase)
    | .[]
    | ["", (.klass + (if .title != "" then "  ·  " + .title else "" end)), .klass]
    | @tsv
  ' <<<"$clients"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_assign() {
  local options=() selected class prefill
  mapfile -t options < <(running_app_options)
  if (( ${#options[@]} == 0 )); then
    notify "Workspace Bindings" "No running windows were found."
    return 0
  fi
  selected=$(omarchy menu select "Assign a running app" "${options[@]}" -- --width 720 --maxheight 620) || return 0
  class="${selected#*$'\t'}"
  [[ -n $class ]] || return 0
  prefill=$(jq -cn --arg class "$class" \
    '{mode:"new", index:-1, class:$class, title:"", monitor:null, slot:1, focus:false}')
  open_form "$prefill"
}

cmd_add() {
  open_form '{"mode":"new","index":-1,"class":"","title":"","monitor":null,"slot":1,"focus":false}'
}

# Open the editor prefilled for the selected binding (by index, so same-class
# scene variants stay distinct).
cmd_manage() {
  local options=() selected index prefill file
  ensure_state
  file="$(state_file)"
  mapfile -t options < <(jq -r '
    .bindings
    | to_entries[]
    | ["󰍹",
       (.value.class + "  →  " + (.value.target.monitor | to_entries[0] | "\(.key):\(.value)")
         + "  workspace " + (.value.target.slot | tostring)
         + (if (.value.focus // false) then "  ·  switch" else "  ·  silent" end)),
       (.key | tostring)]
    | @tsv
  ' "$file")
  if (( ${#options[@]} == 0 )); then
    notify "Workspace Bindings" "There are no bindings yet."
    return 0
  fi
  selected=$(omarchy menu select "Edit binding" "${options[@]}" -- --width 720 --maxheight 620) || return 0
  index="${selected#*$'\t'}"
  [[ $index =~ ^[0-9]+$ ]] || return 0
  prefill=$(jq -c --argjson i "$index" '
    .bindings[$i] as $b
    | { mode: "edit", index: $i, class: $b.class, title: ($b.title // ""),
        monitor: ($b.target.monitor | to_entries[0]
          | { kind: .key, value: (if .key == "id" then (.value | tonumber) else .value end) }),
        slot: $b.target.slot, focus: ($b.focus // false) }
  ' "$file")
  open_form "$prefill"
}

# Called back by the plugin form:
# save-binding <new|edit> <index> <class> <title> <monitor> <workspace> <focus>
cmd_save_binding() {
  [[ $# -eq 7 ]] || die "usage: save-binding <new|edit> <index> <class> <title> <monitor> <workspace> <focus>"
  local mode="$1" index="$2" class="$3" title="$4" monitor="$5" slot="$6" focus="$7" file matcher tmp
  [[ -n $class ]] || die "class must not be empty"
  [[ $slot =~ ^([1-9]|10)$ ]] || die "workspace must be 1..10 (got '$slot')"
  [[ $focus == "true" || $focus == "false" ]] || die "focus must be true or false"

  ensure_state
  file="$(state_file)"
  matcher="$(matcher_json "$monitor")"
  tmp="$(mktemp "${file}.XXXXXX")"
  if [[ $mode == "edit" && $index =~ ^[0-9]+$ ]]; then
    jq --argjson i "$index" --arg class "$class" --arg title "$title" \
      --argjson monitor "$matcher" --argjson slot "$slot" --argjson focus "$focus" \
      '
        .bindings[$i] = (
          { class: $class, target: { monitor: $monitor, slot: $slot }, focus: $focus }
          + (if $title == "" then {} else { title: $title } end)
        )
      ' "$file" >"$tmp"
  else
    jq --arg class "$class" --arg title "$title" \
      --argjson monitor "$matcher" --argjson slot "$slot" --argjson focus "$focus" \
      '
        .version = 1
        | (.bindings // []) as $b
        | ({ class: $class, target: { monitor: $monitor, slot: $slot }, focus: $focus }
           + (if $title == "" then {} else { title: $title } end)) as $e
        | ($b | map(.class == $class and .target.monitor == $monitor) | index(true)) as $at
        | .bindings = (if $at == null then $b + [$e] else ($b | .[$at] = $e) end)
      ' "$file" >"$tmp"
  fi
  mv "$tmp" "$file"
  apply_bindings
  notify "Workspace binding saved" "$class"
}

cmd_set() {
  [[ $# -eq 4 ]] || die "usage: set <class> <monitor> <workspace> <focus>"
  save_binding "$1" "$2" "$3" "$4"
  apply_bindings
}

cmd_remove() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: remove <class> [monitor]"
  remove_binding "$1" "${2:-}"
  apply_bindings
}

cmd_list() {
  ensure_state
  jq -r '
    .bindings[]
    | [.class, (.target.monitor | to_entries[0] | "\(.key):\(.value)"), (.target.slot | tostring), ((.focus // false) | tostring)]
    | @tsv
  ' "$(state_file)"
}

cmd_status() {
  local file integrated="false" count=0
  file="$(state_file)"
  if [[ -f $file ]]; then
    count=$(jq -r '.bindings | length' "$file" 2>/dev/null || printf '0')
  fi
  if [[ -f $RUNTIME_TARGET ]]; then
    integrated="true"
  fi
  jq -cn \
    --arg profile "$(machine_profile)" \
    --arg source "$file" \
    --argjson assignments "$count" \
    --argjson applied "$integrated" \
    '{plugin: "icyleaf.workspaces", profile: $profile, source: $source, assignments: $assignments, runtimeDeployed: $applied}'
}

cmd_open() {
  ensure_state
  local file
  file="$(state_file)"
  if command -v omarchy-launch-config-editor >/dev/null 2>&1; then
    omarchy-launch-config-editor "$file"
  else
    printf '%s\n' "$file"
  fi
}

main() {
  case "${1:-assign}" in
    assign) shift || true; cmd_assign "$@" ;;
    add) shift || true; cmd_add "$@" ;;
    manage) shift || true; cmd_manage "$@" ;;
    save-binding) shift || true; cmd_save_binding "$@" ;;
    set) shift || true; cmd_set "$@" ;;
    remove) shift || true; cmd_remove "$@" ;;
    list) shift || true; cmd_list "$@" ;;
    status) shift || true; cmd_status "$@" ;;
    open) shift || true; cmd_open "$@" ;;
    apply) shift || true; apply_bindings && notify "Workspace bindings" "Runtime file re-rendered." ;;
    *)
      printf 'Usage: %s [assign|add|manage|set|remove|list|status|open|apply]\n' "${0##*/}" >&2
      return 2
      ;;
  esac
}

require_cmds
main "$@"
