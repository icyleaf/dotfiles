{
  "schemaVersion": 1,
  "id": "icyleaf.herdr",
  "name": "Herdr Sessions",
  "version": "0.1.0",
  "author": "icyleaf",
  "description": "Herdr session overview widget and panel shell.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Herdr Session Overview",
    "description": "Status widget with expandable overview panel shell for Herdr sessions.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaults": {
      "promptDensity": "compact",
      "retentionWindowMs": 6000
    },
    "schema": [
      {
        "key": "promptDensity",
        "type": "enum",
        "label": "Prompt snippet density mode",
        "options": [
          "compact",
          "expanded"
        ],
        "defaultValue": "compact"
      },
      {
        "key": "retentionWindowMs",
        "type": "integer",
        "label": "Failed snapshot retention window (ms)",
        "min": 1000,
        "max": 30000,
        "step": 500,
        "defaultValue": 6000
      }
    ]
  }
}