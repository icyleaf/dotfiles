{{- /* Locally-tested Omarchy plugins (evindor.keystroke, nosignal.motion-wallpaper,
       omaplug, sunny0826.quick-fcitx, hancore.keyboard-center,
       hancore.voxtype-enhance, komagata.input-method) are only referenced on the
       dev machine, identified by machine_profile "darktemplar". They are also
       intentionally absent from .chezmoiexternals/03_omarchy.toml.tmpl, so
       portable machines receive the plugin-free subset instead of references to
       plugins they never cloned. */ -}}
{{- $local := eq .machine_profile "darktemplar" -}}
{
  "version": 1,
  "idle": {
    "screensaver": 30000000000000000,
    "lock": 150
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "icyleaf.workspaces",
    "layout": {
      "left": [
{{- if $local }}
        {
          "id": "evindor.keystroke"
        },
{{- end }}
        {
          "id": "icyleaf.herdr"
        },
        {
          "id": "ryuhzk.simfarm",
          "serverUrl": "http://192.168.10.2:8801",
          "sshHost": "tokyo-mini4",
          "browser": "google-chrome-stable"
        },
{{- if $local }}
        {
          "id": "nosignal.motion-wallpaper"
        },
        {
          "id": "omaplug"
        },
{{- end }}
        {
          "id": "io.github.hominluo.launcher"
        },
        {
          "id": "icyleaf.resources"
        },
        {
          "id": "io.github.iampoul.sysstats"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "center": [
        {
          "id": "icyleaf.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "expanded": true
        },
{{- if $local }}
        {
          "id": "sunny0826.quick-fcitx"
        },
        {
          "id": "hancore.keyboard-center"
        },
        {
          "id": "hancore.voxtype-enhance",
          "middleMouseToggle": false
        },
{{- end }}
        {
          "id": "storage-drives"
        },
{{- if $local }}
        {
          "id": "komagata.input-method"
        },
{{- end }}
        {
          "id": "jankeesvw.notification-center"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "local.clock",
          "showSettingsGear": false,
          "format": "MM-dd HH:mm ddd",
          "formatAlt": "dd MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "firstDayOfWeek": "monday",
          "locale": "ja"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "local.orbit"
    },
    {
      "id": "mirador"
    },
    {
      "id": "icyleaf.notifications"
    },
    {
      "id": "icyleaf.hypr-input-switcher"
    },
    {
      "id": "icyleaf.bitwarden"
    },
    {
      "id": "icyleaf.modict"
    },
    {
      "id": "icyleaf.qalculator",
      "position": "top",
      "edgeMargin": 5
    },
    {
      "id": "alanfortlink.clipboard"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "my-dock"
    },
    {
      "id": "de.gransoftware.yank"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.clipboard"{{ if $local }},
    "omarchy.menu"{{ end }},
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "icyleaf.notifications",
    "ryuhzk.simfarm",
    "local.clock",
    "alanfortlink.clipboard",
    "io.github.sirjul1337.lock-explorer"{{ if $local }},
    "evindor.keystroke"{{ end }}
  ]
}
