    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.clipboard",
    "omarchy.lock",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "icyleaf.notifications",
    "ryuhzk.simfarm",
    "local.clock",
    "alanfortlink.clipboard",
    "io.github.sirjul1337.lock-explorer",
    "evindor.keystroke"
  ]
}
