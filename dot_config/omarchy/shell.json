{
  "version": 1,
  "idle": {
    "screensaver": 10,
    "lock": 20
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "icyleaf.resources"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "center": [
        {
          "id": "icyleaf.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "expanded": true
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.clock",
          "format": "yy-MM-d HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    }
  },
  "plugins": []
