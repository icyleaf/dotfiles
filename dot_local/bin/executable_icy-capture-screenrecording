#!/usr/bin/env bash
#
# icy-capture-screenrecording: middleware wrapper around omarchy-capture-screenrecording
#
# This is the Omarchy-agnostic entry point used by Hyprland/Waybar configs.
# Replace the implementation below to remove the Omarchy dependency.
#
# To replace: implement the desired behaviour directly here and remove
# the delegation to omarchy-capture-screenrecording.

if command -v "omarchy-capture-screenrecording" >/dev/null 2>&1; then
  exec "omarchy-capture-screenrecording" "$@"
else
  echo "icy-capture-screenrecording: 'omarchy-capture-screenrecording' not found. Install Omarchy or implement a replacement." >&2
  exit 127
fi
