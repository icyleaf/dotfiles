#!/usr/bin/env bash
#
# icy-capture-screenshot: middleware wrapper around omarchy-capture-screenshot
#
# Clear inherited Qt/GTK scaling factors so omasnap uses exact compositor geometry
unset QT_SCALE_FACTOR QT_AUTO_SCREEN_SCALE_FACTOR GDK_SCALE

if command -v "omarchy-capture-screenshot" >/dev/null 2>&1; then
  exec "omarchy-capture-screenshot" "$@"
else
  echo "icy-capture-screenshot: 'omarchy-capture-screenshot' not found. Install Omarchy or implement a replacement." >&2
  exit 127
fi
