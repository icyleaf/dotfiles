#!/usr/bin/env bash
#
# icy-capture-text: middleware wrapper around omarchy-capture-text
#
# Clear inherited Qt/GTK scaling factors so omasnap uses exact compositor geometry
unset QT_SCALE_FACTOR QT_AUTO_SCREEN_SCALE_FACTOR GDK_SCALE

if command -v "omarchy-capture-text" >/dev/null 2>&1; then
  exec "omarchy-capture-text" "$@"
else
  echo "icy-capture-text: 'omarchy-capture-text' not found. Install Omarchy or implement a replacement." >&2
  exit 127
fi
