# vim:ft=toml

{{ if ne .chezmoi.os "darwin" }}
{{/* Prefer a system-wide Omarchy install. Only clone the upstream repo into
     ~/.local/share/omarchy when /usr/share/omarchy is not present. */}}
{{ if not (stat "/usr/share/omarchy") }}
[".local/share/omarchy"]
    type = "git-repo"
    url = "https://github.com/basecamp/omarchy.git"
{{ end }}

# Third-party Omarchy Shell Plugins managed declaratively.
# Only plugins that should reach every machine belong here. Dev/test-only
# plugins stay out of this file; the matching references in
# dot_config/omarchy/private_shell.json.tmpl are gated on machine_profile so
# other machines receive neither the clone nor a reference to it.

[".config/omarchy/plugins/Mirador"]
    type = "git-repo"
    url = "https://github.com/sanjyay/Mirador.git"
    refreshPeriod = "168h"

