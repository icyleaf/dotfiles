#!/usr/bin/env bash
#
# Set up Omarchy vendor symlink.
# Links vendor/omarchy (git submodule) → ~/.local/share/omarchy so that
# all `source =` references in Hyprland configs and the OMARCHY_PATH env
# continue to work without requiring a separate Omarchy installation.
#
# To upgrade Omarchy:
#   git submodule update --remote vendor/omarchy
#   git add vendor/omarchy && git commit -m "chore: bump omarchy to <version>"

set -eu

REPO_DIR="{{ .chezmoi.sourceDir }}"
VENDOR_DIR="${REPO_DIR}/vendor/omarchy"
OMARCHY_DIR="${HOME}/.local/share/omarchy"

# Ensure the submodule is initialised (handles fresh chezmoi init --apply)
if [ ! -f "${VENDOR_DIR}/version" ]; then
  echo "Initialising Omarchy submodule..."
  git -C "${REPO_DIR}" submodule update --init vendor/omarchy
fi

# Set up the symlink
if [ -L "${OMARCHY_DIR}" ]; then
  current_target="$(readlink "${OMARCHY_DIR}")"
  if [ "${current_target}" = "${VENDOR_DIR}" ]; then
    echo "Omarchy vendor symlink already in place: ${OMARCHY_DIR} -> ${VENDOR_DIR}"
  else
    echo "Updating Omarchy symlink: ${OMARCHY_DIR} -> ${VENDOR_DIR} (was: ${current_target})"
    ln -sf "${VENDOR_DIR}" "${OMARCHY_DIR}"
  fi
elif [ -d "${OMARCHY_DIR}" ]; then
  echo "Found existing Omarchy directory at ${OMARCHY_DIR}."
  echo "Backing up to ${OMARCHY_DIR}.bak and replacing with vendor symlink..."
  mv "${OMARCHY_DIR}" "${OMARCHY_DIR}.bak"
  ln -s "${VENDOR_DIR}" "${OMARCHY_DIR}"
  echo "Backup created at ${OMARCHY_DIR}.bak"
else
  mkdir -p "$(dirname "${OMARCHY_DIR}")"
  ln -s "${VENDOR_DIR}" "${OMARCHY_DIR}"
  echo "Omarchy vendor symlink created: ${OMARCHY_DIR} -> ${VENDOR_DIR}"
fi
